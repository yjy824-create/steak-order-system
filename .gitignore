# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
jspm_packages/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn-integrity

# testing
/coverage
coverage
*.lcov
.nyc_output

# next.js
/.next/
.next
/out/
out

# production
/build
build/Release
dist
.output

# misc
.DS_Store
*.pem
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.tgz

# debug and logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
next-dev*.log

# diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# runtime data
pids
*.pid
*.seed
*.pid.lock

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# firebase
.firebase/

# typescript
*.tsbuildinfo
next-env.d.ts

# other framework/tool caches
.cache
.parcel-cache
.nuxt
.temp
.svelte-kit/
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
